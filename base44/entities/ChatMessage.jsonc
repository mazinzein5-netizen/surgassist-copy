{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "audio",
        "image"
      ],
      "default": "text"
    },
    "attachment_url": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "role",
    "content"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
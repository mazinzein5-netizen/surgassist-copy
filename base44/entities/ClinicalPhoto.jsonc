{
  "name": "ClinicalPhoto",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "photo_type": {
      "type": "string",
      "enum": [
        "wound",
        "xray",
        "ecg",
        "medication_list",
        "patient_id",
        "other"
      ]
    },
    "photo_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "photo_type",
    "photo_url"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
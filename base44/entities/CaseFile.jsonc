{
  "name": "CaseFile",
  "type": "object",
  "properties": {
    "patient_name": {
      "type": "string"
    },
    "patient_dob": {
      "type": "string",
      "format": "date"
    },
    "patient_mrn": {
      "type": "string"
    },
    "patient_gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "patient_id": {
      "type": "string",
      "description": "Links to Patient entity for cross-visit cloud memory"
    },
    "hospital": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": [
        "orthopaedics",
        "general_surgery"
      ]
    },
    "specialty": {
      "type": "string",
      "description": "Admitting specialty (e.g. Orthopaedics, General Surgery, ENT)"
    },
    "consultant_name": {
      "type": "string",
      "description": "Name of the admitting consultant"
    },
    "bed_number": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "accepting_specialty": {
      "type": "string",
      "description": "The specific specialty that accepted the referral (e.g., Orthopaedics, General Surgery)"
    },
    "on_call_consultant": {
      "type": "string",
      "description": "Name of the consultant on-call at time of referral"
    },
    "on_call_registrar": {
      "type": "string",
      "description": "Name of the registrar on-call at time of referral"
    },
    "on_call_sho": {
      "type": "string",
      "description": "Name of the senior house officer on-call at time of referral"
    },
    "referrer_name": {
      "type": "string",
      "description": "Name of the person making the referral"
    },
    "referrer_grade": {
      "type": "string",
      "enum": [
        "intern",
        "sho",
        "registrar",
        "consultant",
        "nursing",
        "other"
      ],
      "description": "Professional grade of the referrer"
    },
    "referrer_department": {
      "type": "string",
      "description": "Department/team of the referrer (e.g. ED, Ward 3B, Orthopaedics)"
    },
    "referrer_contact": {
      "type": "string",
      "description": "Direct contact: phone, WhatsApp, or extension"
    },
    "status": {
      "type": "string",
      "enum": [
        "referral_intake",
        "triage",
        "accepted",
        "declined",
        "clerking",
        "investigations",
        "admitted",
        "discharged",
        "inews_consult"
      ],
      "default": "referral_intake"
    },
    "referral_mode": {
      "type": "string",
      "enum": [
        "audio",
        "text",
        "screenshot",
        "camera"
      ]
    },
    "referral_summary": {
      "type": "string"
    },
    "presenting_complaint": {
      "type": "string"
    },
    "mechanism_of_injury": {
      "type": "string"
    },
    "referring_team": {
      "type": "string"
    },
    "triage_decision": {
      "type": "string",
      "enum": [
        "pending",
        "accept",
        "decline",
        "needs_more_info"
      ]
    },
    "triage_reasoning": {
      "type": "string"
    },
    "triage_guideline": {
      "type": "string"
    },
    "classification_used": {
      "type": "string"
    },
    "pre_clerking_guidance": {
      "type": "string"
    },
    "clerking_data": {
      "type": "object"
    },
    "proforma_data": {
      "type": "object",
      "description": "Yes/no toggle proforma answers for orthopedic clerking"
    },
    "investigation_recommendations": {
      "type": "string"
    },
    "investigation_data": {
      "type": "object",
      "description": "Structured investigations: { bloods: string[], imaging: string[] }"
    },
    "admission_note": {
      "type": "string",
      "description": "Generated concise admission note with plan"
    },
    "admission_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the patient was admitted"
    },
    "admission_recommendation": {
      "type": "string"
    },
    "admission_department": {
      "type": "string"
    },
    "pre_op_status": {
      "type": "string",
      "enum": [
        "not_listed",
        "listed",
        "in_theatre",
        "post_op",
        "not_applicable"
      ],
      "default": "not_listed",
      "description": "Current surgical pathway status"
    },
    "procedure_name": {
      "type": "string",
      "description": "Planned or performed procedure"
    },
    "procedure_date": {
      "type": "string",
      "format": "date",
      "description": "Date of procedure"
    },
    "pod": {
      "type": "number",
      "description": "Post-operative day number"
    },
    "kardex_data": {
      "type": "object"
    },
    "iv_fluid_plan": {
      "type": "string"
    },
    "treatment_plan": {
      "type": "string"
    },
    "discharge_pathway": {
      "type": "string",
      "enum": [
        "not_discharged",
        "opd_followup",
        "no_followup"
      ]
    },
    "gp_letter": {
      "type": "string"
    },
    "patient_education_sheet": {
      "type": "string"
    },
    "consent_checklist": {
      "type": "string"
    },
    "inews_score": {
      "type": "number"
    },
    "inews_data": {
      "type": "object"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "countersigned"
      ],
      "default": "pending"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewer_imc": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "countersigned_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "patient_name",
    "department"
  ]
}
{
  "name": "TheatreLog",
  "type": "object",
  "properties": {
    "patient_name": {
      "type": "string"
    },
    "patient_mrn": {
      "type": "string"
    },
    "procedure_date": {
      "type": "string",
      "format": "date"
    },
    "procedure_name": {
      "type": "string"
    },
    "procedure_role": {
      "type": "string",
      "enum": [
        "primary_surgeon",
        "first_assistant",
        "second_assistant",
        "observing"
      ]
    },
    "supervisor_name": {
      "type": "string"
    },
    "supervisor_imc": {
      "type": "string"
    },
    "supervisor_signed": {
      "type": "boolean",
      "default": false
    },
    "department": {
      "type": "string",
      "enum": [
        "orthopaedics",
        "general_surgery"
      ]
    },
    "notes": {
      "type": "string"
    },
    "learning_points": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Set to true when case is discharged to archive the record"
    }
  },
  "required": [
    "patient_name",
    "procedure_name",
    "procedure_date",
    "department"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}